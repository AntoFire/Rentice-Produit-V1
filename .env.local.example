# Copie ce fichier en .env.local (déjà exclu par .gitignore) et remplis les
# valeurs. Reporte les mêmes variables dans Vercel > Settings > Environment
# Variables (Production ET Preview). Aucune ne doit porter le préfixe
# NEXT_PUBLIC_ — elles ne sont utilisées que côté serveur, encapsulées dans
# lib/<service>.ts.

ANTHROPIC_API_KEY=
APOLLO_API_KEY=
UNIPILE_API_KEY=
UNIPILE_BASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CAMPAIGN_TOKEN_SECRET=

# Ajoutée à l'étape 6 (Vercel Cron) — protège /api/cron/dispatch.
CRON_SECRET=
